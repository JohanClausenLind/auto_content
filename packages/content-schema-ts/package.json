{
  "name": "@content-factory/content-schema-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript types + compiled Ajv validators from the Pydantic source of truth",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
