{
  "$defs": {
    "ModelRequirement": {
      "additionalProperties": false,
      "description": "A weight or skill environment a workflow needs before it can run.\n\n``kind=\"comfy\"`` resolves inside ComfyUI's model folders, ``kind=\"path\"`` is a directory in the\nweight store, ``kind=\"skill\"`` is a skill env under ``skills/``. The web panel turns these into\na readiness column and a download command.",
      "properties": {
        "filename": {
          "default": "",
          "maxLength": 200,
          "title": "Filename",
          "type": "string"
        },
        "folder": {
          "default": "",
          "maxLength": 64,
          "title": "Folder",
          "type": "string"
        },
        "kind": {
          "enum": [
            "comfy",
            "path",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "path_includes": {
          "default": "",
          "maxLength": 200,
          "title": "Path Includes",
          "type": "string"
        },
        "skill": {
          "default": "",
          "maxLength": 120,
          "title": "Skill",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "maxLength": 500,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "folder",
        "kind",
        "label",
        "optional",
        "path_includes",
        "skill",
        "source_url"
      ],
      "title": "ModelRequirement",
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 400,
          "title": "Note",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 80,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "key",
        "note",
        "title",
        "type",
        "values",
        "x",
        "y"
      ],
      "title": "WorkflowNode",
      "type": "object"
    },
    "WorkflowWire": {
      "additionalProperties": false,
      "properties": {
        "from_key": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "From Key",
          "type": "string"
        },
        "from_slot": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "From Slot",
          "type": "string"
        },
        "to_key": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "To Key",
          "type": "string"
        },
        "to_slot": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "To Slot",
          "type": "string"
        }
      },
      "required": [
        "from_key",
        "from_slot",
        "to_key",
        "to_slot"
      ],
      "title": "WorkflowWire",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/WorkflowTemplate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A complete workflow: what it is for, what it needs, its graph, and its run order.",
  "properties": {
    "category": {
      "enum": [
        "image",
        "video",
        "audio",
        "article",
        "email",
        "social",
        "utility"
      ],
      "title": "Category",
      "type": "string"
    },
    "caveat": {
      "default": "",
      "maxLength": 400,
      "title": "Caveat",
      "type": "string"
    },
    "description": {
      "maxLength": 600,
      "minLength": 10,
      "title": "Description",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,48}$",
      "title": "Id",
      "type": "string"
    },
    "models": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelRequirement"
      },
      "title": "Models",
      "type": "array"
    },
    "name": {
      "maxLength": 80,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "order": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Order",
      "type": "array"
    },
    "prerequisite": {
      "default": "",
      "maxLength": 400,
      "title": "Prerequisite",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "wires": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkflowWire"
      },
      "title": "Wires",
      "type": "array"
    }
  },
  "required": [
    "category",
    "caveat",
    "description",
    "id",
    "models",
    "name",
    "nodes",
    "order",
    "prerequisite",
    "schema_version",
    "tags",
    "wires"
  ],
  "title": "WorkflowTemplate",
  "type": "object"
}
