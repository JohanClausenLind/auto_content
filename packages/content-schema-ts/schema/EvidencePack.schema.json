{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "description": "A derived value the compiler recomputes; the script may not carry one it cannot reproduce.",
      "properties": {
        "calc_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Calc Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "sub",
            "mul",
            "div"
          ],
          "title": "Op",
          "type": "string"
        },
        "operands": {
          "items": {
            "discriminator": {
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ClaimOperand"
              },
              {
                "$ref": "#/$defs/ConstantOperand"
              }
            ],
            "type": "object"
          },
          "minItems": 2,
          "title": "Operands",
          "type": "array"
        },
        "result_claim_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Result Claim Id",
          "type": "string"
        }
      },
      "required": [
        "calc_id",
        "op",
        "operands",
        "result_claim_id"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One statement the episode may make, classified, valued, and tied to its evidence.",
      "properties": {
        "calculation_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Id"
        },
        "checked_at": {
          "minLength": 4,
          "title": "Checked At",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "consequential": {
          "default": false,
          "title": "Consequential",
          "type": "boolean"
        },
        "corroboration": {
          "$ref": "#/$defs/Corroboration",
          "default": {
            "independent_source_ids": [],
            "note": "",
            "status": "not_required"
          }
        },
        "disputed": {
          "default": false,
          "title": "Disputed",
          "type": "boolean"
        },
        "epistemic_class": {
          "enum": [
            "observation",
            "interpretation",
            "forecast",
            "illustrative_assumption"
          ],
          "title": "Epistemic Class",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "geography": {
          "default": "",
          "maxLength": 120,
          "title": "Geography",
          "type": "string"
        },
        "rationale": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "short_label": {
          "default": "",
          "maxLength": 40,
          "title": "Short Label",
          "type": "string"
        },
        "stable": {
          "default": false,
          "title": "Stable",
          "type": "boolean"
        },
        "statement": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "time_basis": {
          "default": "",
          "maxLength": 80,
          "title": "Time Basis",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "calculation_id",
        "checked_at",
        "claim_id",
        "consequential",
        "corroboration",
        "disputed",
        "epistemic_class",
        "evidence_ids",
        "geography",
        "rationale",
        "short_label",
        "stable",
        "statement",
        "time_basis",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimOperand": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "const": "claim",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind"
      ],
      "title": "ClaimOperand",
      "type": "object"
    },
    "ConstantOperand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "constant",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ConstantOperand",
      "type": "object"
    },
    "Corroboration": {
      "additionalProperties": false,
      "properties": {
        "independent_source_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
            "type": "string"
          },
          "title": "Independent Source Ids",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 300,
          "title": "Note",
          "type": "string"
        },
        "status": {
          "enum": [
            "corroborated",
            "single_source",
            "conflicting",
            "not_required"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "independent_source_ids",
        "note",
        "status"
      ],
      "title": "Corroboration",
      "type": "object"
    },
    "DatasetColumn": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "quantitative",
            "temporal",
            "ordinal",
            "nominal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "unit"
      ],
      "title": "DatasetColumn",
      "type": "object"
    },
    "DatasetRow": {
      "additionalProperties": false,
      "description": "One row; every quantitative cell must equal a claim value listed in claim_ids.",
      "properties": {
        "claim_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "claim_ids",
        "key",
        "values"
      ],
      "title": "DatasetRow",
      "type": "object"
    },
    "EvidenceDataset": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/DatasetRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "default": "",
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "dataset_id",
        "rows",
        "title"
      ],
      "title": "EvidenceDataset",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "The exact passage or cell a claim rests on, with enough context to keep its qualifiers.",
      "properties": {
        "context_after": {
          "default": "",
          "maxLength": 400,
          "title": "Context After",
          "type": "string"
        },
        "context_before": {
          "default": "",
          "maxLength": 400,
          "title": "Context Before",
          "type": "string"
        },
        "geography": {
          "default": "",
          "maxLength": 120,
          "title": "Geography",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Item Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "passage": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "quoted_at": {
          "minLength": 4,
          "title": "Quoted At",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Source Id",
          "type": "string"
        },
        "time_basis": {
          "default": "",
          "maxLength": 80,
          "title": "Time Basis",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "context_after",
        "context_before",
        "geography",
        "item_id",
        "locator",
        "passage",
        "quoted_at",
        "source_id",
        "time_basis",
        "unit"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "char_range",
            "pdf_page",
            "table_cell",
            "timestamp_ms"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "end",
        "kind",
        "start"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "One publication we read; content_sha256 is what it said, accessed_at is when we looked.",
      "properties": {
        "accessed_at": {
          "minLength": 4,
          "title": "Accessed At",
          "type": "string"
        },
        "author": {
          "default": "",
          "maxLength": 200,
          "title": "Author",
          "type": "string"
        },
        "canonical_url": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "capture_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Id"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "default": "",
          "maxLength": 200,
          "title": "Publisher",
          "type": "string"
        },
        "rights_status": {
          "$ref": "#/$defs/RightsStatus",
          "default": "quotable_excerpt"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass",
          "default": "unknown"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "accessed_at",
        "author",
        "canonical_url",
        "capture_id",
        "content_sha256",
        "published_at",
        "publisher",
        "rights_status",
        "source_class",
        "source_id",
        "title",
        "url"
      ],
      "title": "EvidenceSource",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A finite magnitude with a unit; comparisons convert units, never compare unit strings.",
      "properties": {
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "uncertainty": {
          "default": "exact",
          "enum": [
            "exact",
            "rounded",
            "estimate",
            "interval"
          ],
          "title": "Uncertainty",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "high",
        "low",
        "magnitude",
        "uncertainty",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "quotable_excerpt",
        "licensed",
        "operator_owned",
        "public_domain",
        "restricted"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "official",
        "primary",
        "reference",
        "news",
        "analysis",
        "blog",
        "social",
        "operator_upload",
        "unknown"
      ],
      "title": "SourceClass",
      "type": "string"
    }
  },
  "$id": "https://content-factory.local/schema/EvidencePack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every source, passage, claim, dataset and calculation an episode may use, frozen first.",
  "properties": {
    "calculations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Calculation"
      },
      "title": "Calculations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "datasets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceDataset"
      },
      "title": "Datasets",
      "type": "array"
    },
    "frozen_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "language": {
      "default": "en",
      "maxLength": 8,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "pack_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Pack Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "topic": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    }
  },
  "required": [
    "calculations",
    "claims",
    "datasets",
    "frozen_at",
    "items",
    "language",
    "pack_id",
    "schema_version",
    "sources",
    "topic"
  ],
  "title": "EvidencePack",
  "type": "object"
}
