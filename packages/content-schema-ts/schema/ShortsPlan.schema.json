{
  "$defs": {
    "ShortExcerpt": {
      "additionalProperties": false,
      "description": "One derived short: a contiguous, self-contained run of long-form beats plus its hook.\n\n``hook_text`` equal to the first beat's display text means \"verbatim\" — the claims on that\nbeat survive into the short. A rewritten hook is a new statement: the derived plan drops the\nclaim links on that beat rather than pretending the citation still holds.",
      "properties": {
        "claim_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "duration_ms": {
          "minimum": 1000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "hook_text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Hook Text",
          "type": "string"
        },
        "short_deliverable_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Short Deliverable Id",
          "type": "string"
        },
        "source_beat_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Beat Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_ids",
        "duration_ms",
        "hook_text",
        "short_deliverable_id",
        "source_beat_ids"
      ],
      "title": "ShortExcerpt",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/ShortsPlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "excerpts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ShortExcerpt"
      },
      "title": "Excerpts",
      "type": "array"
    },
    "long_deliverable_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Long Deliverable Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "excerpts",
    "long_deliverable_id",
    "plan_id",
    "schema_version"
  ],
  "title": "ShortsPlan",
  "type": "object"
}
