{
  "$defs": {
    "CaptionCue": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "end_ms",
        "index",
        "lines",
        "start_ms"
      ],
      "title": "CaptionCue",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/CaptionTrack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cues": {
      "items": {
        "$ref": "#/$defs/CaptionCue"
      },
      "minItems": 1,
      "title": "Cues",
      "type": "array"
    },
    "deliverable_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Deliverable Id",
      "type": "string"
    },
    "language": {
      "default": "en",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "title": "Language",
      "type": "string"
    },
    "max_chars_per_line": {
      "default": 32,
      "maximum": 60,
      "minimum": 10,
      "title": "Max Chars Per Line",
      "type": "integer"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "style": {
      "default": "documentary",
      "enum": [
        "documentary",
        "burned_in_restrained"
      ],
      "title": "Style",
      "type": "string"
    }
  },
  "required": [
    "cues",
    "deliverable_id",
    "language",
    "max_chars_per_line",
    "schema_version",
    "style"
  ],
  "title": "CaptionTrack",
  "type": "object"
}
