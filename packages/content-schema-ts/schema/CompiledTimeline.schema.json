{
  "$defs": {
    "AudioCue": {
      "additionalProperties": false,
      "properties": {
        "asset_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Sha256"
        },
        "beat_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Beat Id",
          "type": "string"
        },
        "duration_frames": {
          "minimum": 1,
          "title": "Duration Frames",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "asset_sha256",
        "beat_id",
        "duration_frames",
        "start_frame"
      ],
      "title": "AudioCue",
      "type": "object"
    },
    "CompiledScene": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Beat Id",
          "type": "string"
        },
        "duration_frames": {
          "minimum": 1,
          "title": "Duration Frames",
          "type": "integer"
        },
        "scene_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "transition_in_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Transition In Frames",
          "type": "integer"
        },
        "word_cues": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Word Cues",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "duration_frames",
        "scene_id",
        "start_frame",
        "transition_in_frames",
        "word_cues"
      ],
      "title": "CompiledScene",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/CompiledTimeline.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Renderer truth: integer frames only. Owned by the timeline compiler.",
  "properties": {
    "audio": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AudioCue"
      },
      "title": "Audio",
      "type": "array"
    },
    "compiler_version": {
      "title": "Compiler Version",
      "type": "string"
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ],
      "title": "Fps",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Plan Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/CompiledScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timeline_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Timeline Id",
      "type": "string"
    },
    "total_frames": {
      "minimum": 1,
      "title": "Total Frames",
      "type": "integer"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "audio",
    "compiler_version",
    "fps",
    "height",
    "plan_hash",
    "plan_id",
    "scenes",
    "schema_version",
    "timeline_id",
    "total_frames",
    "width"
  ],
  "title": "CompiledTimeline",
  "type": "object"
}
