{
  "$defs": {
    "EpisodeSection": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EpisodeSectionKind"
        },
        "purpose": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "integer"
        },
        "word_budget": {
          "minimum": 1,
          "title": "Word Budget",
          "type": "integer"
        }
      },
      "required": [
        "end_s",
        "kind",
        "purpose",
        "start_s",
        "word_budget"
      ],
      "title": "EpisodeSection",
      "type": "object"
    },
    "EpisodeSectionKind": {
      "enum": [
        "cold_open",
        "question_stakes",
        "build_model",
        "run_system",
        "change_variable",
        "show_limits",
        "synthesis"
      ],
      "title": "EpisodeSectionKind",
      "type": "string"
    }
  },
  "$id": "https://content-factory.local/schema/EpisodeOutline.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Planning skeleton for a long-form episode. Sections tile the target duration exactly.",
  "properties": {
    "deliverable_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Deliverable Id",
      "type": "string"
    },
    "outline_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Outline Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/EpisodeSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "target_duration_s": {
      "maximum": 3600,
      "minimum": 60,
      "title": "Target Duration S",
      "type": "integer"
    },
    "words_per_minute": {
      "default": 145,
      "maximum": 200,
      "minimum": 100,
      "title": "Words Per Minute",
      "type": "integer"
    }
  },
  "required": [
    "deliverable_id",
    "outline_id",
    "schema_version",
    "sections",
    "target_duration_s",
    "words_per_minute"
  ],
  "title": "EpisodeOutline",
  "type": "object"
}
