{
  "$defs": {
    "Affection": {
      "enum": [
        "affection",
        "neutral",
        "aggression",
        "staging"
      ],
      "title": "Affection",
      "type": "string"
    },
    "ContactTag": {
      "enum": [
        "none",
        "hands",
        "arm",
        "shoulder",
        "torso",
        "back",
        "head_shoulder",
        "head_chest",
        "face",
        "lap",
        "object"
      ],
      "title": "ContactTag",
      "type": "string"
    },
    "InteractionTag": {
      "enum": [
        "handshake",
        "hug",
        "kiss",
        "hold_hands_walk",
        "hand_on_shoulder",
        "hands_on_shoulders",
        "comfort_kneeling",
        "shoulder_rub",
        "shelter_child",
        "link_arms_walk",
        "lead_by_arm",
        "help_up",
        "meet_and_sit",
        "walk_together",
        "conversation",
        "swing_partner",
        "dance_novelty",
        "ring_around",
        "high_five",
        "low_five",
        "pass_object",
        "exchange_object",
        "throw_catch",
        "exercise_together",
        "march",
        "blindfold_tag",
        "race_for_seat",
        "stumble_into",
        "approach",
        "depart",
        "no_contact",
        "pull_resist",
        "pull_by_elbow",
        "arm_wrestle",
        "quarrel",
        "stare_down",
        "threaten",
        "kick",
        "punch",
        "push",
        "point",
        "head_on_shoulder",
        "cuddle",
        "slow_dance",
        "carry_child",
        "stroke_hair",
        "hold_face"
      ],
      "title": "InteractionTag",
      "type": "string"
    },
    "Posture": {
      "enum": [
        "standing",
        "sitting",
        "kneeling",
        "walking",
        "running",
        "crouching",
        "lying",
        "dancing",
        "leaning"
      ],
      "title": "Posture",
      "type": "string"
    },
    "ReferenceMatch": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "pattern": "^[a-z0-9][a-z0-9_]{2,63}$",
          "title": "Clip Id",
          "type": "string"
        },
        "matched_contact": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Matched Contact",
          "type": "array"
        },
        "matched_interaction": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Matched Interaction",
          "type": "array"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "snippet": {
          "default": "",
          "maxLength": 400,
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "matched_contact",
        "matched_interaction",
        "rank",
        "score",
        "snippet"
      ],
      "title": "ReferenceMatch",
      "type": "object"
    },
    "ReferenceQuery": {
      "additionalProperties": false,
      "description": "A question in words plus the constraints that are not words.",
      "properties": {
        "limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "min_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration S"
        },
        "people_count": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "People Count"
        },
        "require_affection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Affection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "require_contact": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContactTag"
          },
          "title": "Require Contact",
          "type": "array"
        },
        "require_interaction": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InteractionTag"
          },
          "title": "Require Interaction",
          "type": "array"
        },
        "require_pose": {
          "default": false,
          "title": "Require Pose",
          "type": "boolean"
        },
        "require_posture": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Posture"
          },
          "title": "Require Posture",
          "type": "array"
        },
        "require_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "limit",
        "max_duration_s",
        "min_duration_s",
        "people_count",
        "require_affection",
        "require_contact",
        "require_interaction",
        "require_pose",
        "require_posture",
        "require_usage",
        "sources",
        "text"
      ],
      "title": "ReferenceQuery",
      "type": "object"
    },
    "ReferenceSource": {
      "enum": [
        "cmu_mocap",
        "harmony4d",
        "sbu_kinect",
        "ut_interaction",
        "tv_human_interactions",
        "motionhub_egobody",
        "motionhub_grab",
        "motionhub_humanml3d",
        "pexels",
        "operator_recording"
      ],
      "title": "ReferenceSource",
      "type": "string"
    },
    "UsageClass": {
      "description": "What the material is good for, measured rather than assumed.",
      "enum": [
        "reference_only",
        "pose_derivable",
        "pixels_usable"
      ],
      "title": "UsageClass",
      "type": "string"
    }
  },
  "$id": "https://content-factory.local/schema/ReferenceMatchSet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The answer, including what the query was understood to mean.\n\n``expanded_terms`` and ``unmatched_words`` are not diagnostics, they are the answer's honesty:\na caller can see that \"head on shoulder\" was understood, searched for, and found nothing.",
  "properties": {
    "absent_terms": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Absent Terms",
      "type": "array"
    },
    "expanded_terms": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expanded Terms",
      "type": "array"
    },
    "lexicon_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Lexicon Sha256",
      "type": "string"
    },
    "library_id": {
      "maxLength": 64,
      "minLength": 3,
      "title": "Library Id",
      "type": "string"
    },
    "match_expression": {
      "default": "",
      "maxLength": 4000,
      "title": "Match Expression",
      "type": "string"
    },
    "matches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReferenceMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/ReferenceQuery"
    },
    "retriever": {
      "const": "fts5_bm25",
      "default": "fts5_bm25",
      "title": "Retriever",
      "type": "string"
    },
    "retriever_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Retriever Version",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "unmatched_words": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unmatched Words",
      "type": "array"
    }
  },
  "required": [
    "absent_terms",
    "expanded_terms",
    "lexicon_sha256",
    "library_id",
    "match_expression",
    "matches",
    "query",
    "retriever",
    "retriever_version",
    "schema_version",
    "unmatched_words"
  ],
  "title": "ReferenceMatchSet",
  "type": "object"
}
