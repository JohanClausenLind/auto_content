{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "H",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "h",
        "w",
        "x",
        "y"
      ],
      "title": "Box",
      "type": "object"
    },
    "Easing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ],
      "title": "Easing",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "description": "Normalized coordinates in [0, 1] relative to the frame.",
      "properties": {
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "SkeletonPose": {
      "additionalProperties": false,
      "description": "A named subset of an OpenPose-style body/hand rig, all points normalized.",
      "properties": {
        "bones": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Bones",
          "type": "array"
        },
        "joints": {
          "additionalProperties": {
            "$ref": "#/$defs/Point"
          },
          "title": "Joints",
          "type": "object"
        }
      },
      "required": [
        "bones",
        "joints"
      ],
      "title": "SkeletonPose",
      "type": "object"
    },
    "SubjectKeyframe": {
      "additionalProperties": false,
      "properties": {
        "easing_to_next": {
          "$ref": "#/$defs/Easing",
          "default": "ease_in_out"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkeletonPose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "easing_to_next",
        "frame_index",
        "layout",
        "pose"
      ],
      "title": "SubjectKeyframe",
      "type": "object"
    },
    "TrackedSubject": {
      "additionalProperties": false,
      "properties": {
        "keyframes": {
          "items": {
            "$ref": "#/$defs/SubjectKeyframe"
          },
          "minItems": 1,
          "title": "Keyframes",
          "type": "array"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "keyframes",
        "label",
        "subject_id"
      ],
      "title": "TrackedSubject",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/MotionPlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canvas_height": {
      "maximum": 8192,
      "minimum": 64,
      "title": "Canvas Height",
      "type": "integer"
    },
    "canvas_width": {
      "maximum": 8192,
      "minimum": 64,
      "title": "Canvas Width",
      "type": "integer"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "frame_count": {
      "maximum": 600,
      "minimum": 1,
      "title": "Frame Count",
      "type": "integer"
    },
    "plan_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Sequence Id",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/TrackedSubject"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    }
  },
  "required": [
    "canvas_height",
    "canvas_width",
    "description",
    "frame_count",
    "plan_id",
    "schema_version",
    "sequence_id",
    "subjects"
  ],
  "title": "MotionPlan",
  "type": "object"
}
