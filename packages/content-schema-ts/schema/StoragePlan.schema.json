{
  "$defs": {
    "RoleAssignment": {
      "additionalProperties": false,
      "properties": {
        "allow_synced_replicas": {
          "default": false,
          "title": "Allow Synced Replicas",
          "type": "boolean"
        },
        "min_free_reserve_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Min Free Reserve Bytes",
          "type": "integer"
        },
        "quota_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quota Bytes"
        },
        "role": {
          "$ref": "#/$defs/StorageRole"
        },
        "root_path": {
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "volume_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Volume Id",
          "type": "string"
        }
      },
      "required": [
        "allow_synced_replicas",
        "min_free_reserve_bytes",
        "quota_bytes",
        "role",
        "root_path",
        "volume_id"
      ],
      "title": "RoleAssignment",
      "type": "object"
    },
    "StorageRole": {
      "enum": [
        "scratch",
        "model_cache",
        "durable_archive",
        "artifact_exchange",
        "cloud_cache",
        "backup"
      ],
      "title": "StorageRole",
      "type": "string"
    }
  },
  "$id": "https://content-factory.local/schema/StoragePlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/RoleAssignment"
      },
      "minItems": 1,
      "title": "Assignments",
      "type": "array"
    },
    "node_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Node Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "assignments",
    "node_id",
    "schema_version"
  ],
  "title": "StoragePlan",
  "type": "object"
}
