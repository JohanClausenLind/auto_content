    "SegmentClipPose": {
      "additionalProperties": false,
      "description": "A ``cf.clip.v2`` motion clip: captured world segment directions, aimed onto whatever rig is\nloaded at render time.\n\n``ClipPose`` stores a quaternion per bone, which makes a clip specific to the body it was\nsolved on: MPFB fits its rig to each character mesh, so the same quaternions land up to 22.6\ndegrees wrong on a different character (measured across the four built assets). Directions are\na property of the motion, so one clip is exact on every body.\n\n``actor`` selects which performer of a multi-person clip this character plays. A two-person\ncapture is one clip with both actors on one timeline, so two ``CharacterSpec`` entries pointing\nat the same clip with different actors reproduce the captured contact instead of staging two\nsolo clips near each other.",
      "properties": {
        "actor": {
          "default": "a",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Actor",
          "type": "string"
        },
        "kind": {
          "const": "segments",
          "default": "segments",
          "title": "Kind",
          "type": "string"
        },
        "loop": {
          "default": false,
          "title": "Loop",
          "type": "boolean"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "offset_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Offset Frames",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "actor",
        "kind",
        "loop",
        "name",
        "offset_frames",
        "speed"
      ],
      "title": "SegmentClipPose",
      "type": "object"
    },
