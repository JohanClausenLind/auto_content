      ],
      "title": "WallsSpec",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/ShotSpec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One shot: everything the Blender scene controller needs to render its control passes.",
  "properties": {
    "action": {
      "default": "",
      "maxLength": 600,
      "title": "Action",
      "type": "string"
    },
    "anchor_frames": {
      "default": [
        0
      ],
      "items": {
        "type": "integer"
      },
      "title": "Anchor Frames",
      "type": "array"
    },
    "beat_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Beat Id"
    },
    "camera": {
      "$ref": "#/$defs/CameraSpec"
    },
    "characters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CharacterSpec"
      },
      "title": "Characters",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "end_state": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End State"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentSpec",
      "default": {
        "background_color": [
          0.05,
          0.05,
          0.06
        ],
        "ground": {
          "color": [
            0.35,
            0.35,
            0.35
          ],
          "enabled": true,
          "seg": false,
          "size": 40.0
        },
        "walls": null
      }
    },
    "fps": {
      "default": 24,
      "enum": [
        24,
        25,
        30,
        60
      ],
      "title": "Fps",
      "type": "integer"
    },
    "frame_count": {
      "maximum": 600,
      "minimum": 1,
      "title": "Frame Count",
      "type": "integer"
    },
    "height": {
      "maximum": 8192,
      "minimum": 64,
      "multipleOf": 32,
      "title": "Height",
      "type": "integer"
    },
    "lighting": {
      "$ref": "#/$defs/LightingSpec",
      "default": {
        "intensity": 1.0,
        "key_azimuth_deg": 35.0,
        "key_elevation_deg": 45.0,
        "preset": "studio",
        "shadows": true
      }
    },
    "motion_prompt": {
      "default": "",
      "maxLength": 2000,
      "title": "Motion Prompt",
      "type": "string"
    },
    "order": {
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "props": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PropSpec"
      },
      "title": "Props",
      "type": "array"
    },
    "render": {
      "$ref": "#/$defs/RenderSpec",
      "default": {
        "canny": {
          "high": 200,
          "low": 100
        },
        "depth_range": "auto",
        "engine": "workbench",
        "frames": null,
        "passes": [
          "rough_rgb",
          "depth",
          "depth_exr",
          "normals",
          "segmentation",
          "pose_skeleton",
          "layout_boxes"
        ]
      }
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "shot_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Shot Id",
      "type": "string"
    },
    "staging_note": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Staging Note"
    },
    "width": {
      "maximum": 8192,
      "minimum": 64,
      "multipleOf": 32,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "action",
    "anchor_frames",
    "beat_id",
    "camera",
    "characters",
    "description",
    "end_state",
    "environment",
    "fps",
    "frame_count",
    "height",
    "lighting",
    "motion_prompt",
    "order",
    "props",
    "render",
    "schema_version",
    "seed",
    "shot_id",
    "staging_note",
    "width"
  ],
  "title": "ShotSpec",
  "type": "object"
}
