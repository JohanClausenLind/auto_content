{
  "$defs": {
    "SoundCue": {
      "additionalProperties": false,
      "description": "One sound from the curated library, at one place, for one stated reason.\n\n``assets/sfx`` has held 49 curated, loudness-measured, provenance-tracked sounds since\n2026-09-07 and **nothing placed any of them**: the only non-speech audio a film could get was\na generated MMAudio bed, so a chart drawing itself on screen was silent and a hard cut between\ntwo cards had nothing on it. This is the contract that says where a sound goes.\n\n``reason`` is required and is not decoration. A cue sheet is the one part of the mix a person\nreads rather than hears, and \"chart_reveal at 12.4 s because scn_chart000001 is a chart\" is\nreviewable where a bare id and a timestamp are not.",
      "properties": {
        "at_ms": {
          "minimum": 0,
          "title": "At Ms",
          "type": "integer"
        },
        "cue_id": {
          "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
          "title": "Cue Id",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "fade_in_ms": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Fade In Ms",
          "type": "integer"
        },
        "fade_out_ms": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Fade Out Ms",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 0,
          "title": "Gain Db",
          "type": "number"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SoundCueRole"
        },
        "scene_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "sound_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Sound Id",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "cue_id",
        "duration_ms",
        "fade_in_ms",
        "fade_out_ms",
        "gain_db",
        "reason",
        "role",
        "scene_id",
        "sound_id"
      ],
      "title": "SoundCue",
      "type": "object"
    },
    "SoundCueRole": {
      "description": "What a cue is doing, which decides how it is placed and how loud it sits.",
      "enum": [
        "bed",
        "transition",
        "accent",
        "room_tone"
      ],
      "title": "SoundCueRole",
      "type": "string"
    }
  },
  "$id": "https://content-factory.local/schema/CueSheet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every library sound in one deliverable's mix, in time order.\n\nTied to the library it was cut against by ``library_sha256``: a cue names a sound by id, and an\nid that resolves to different bytes than the sheet was reviewed with is a different mix. The\nrenderer refuses a sheet whose library has moved rather than quietly using the new sound.",
  "properties": {
    "cues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SoundCue"
      },
      "title": "Cues",
      "type": "array"
    },
    "deliverable_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Deliverable Id",
      "type": "string"
    },
    "library_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Library Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total_ms": {
      "minimum": 1,
      "title": "Total Ms",
      "type": "integer"
    }
  },
  "required": [
    "cues",
    "deliverable_id",
    "library_sha256",
    "schema_version",
    "total_ms"
  ],
  "title": "CueSheet",
  "type": "object"
}
