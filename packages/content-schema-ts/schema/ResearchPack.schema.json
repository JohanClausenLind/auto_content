{
  "$id": "https://content-factory.local/schema/ResearchPack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brief_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Brief Id",
      "type": "string"
    },
    "claim_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "created_at": {
      "minLength": 4,
      "title": "Created At",
      "type": "string"
    },
    "pack_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Pack Id",
      "type": "string"
    },
    "queries": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Queries",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "workspace_id": {
      "pattern": "^ws_[A-Za-z0-9_-]{8,32}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "brief_id",
    "claim_ids",
    "created_at",
    "pack_id",
    "queries",
    "schema_version",
    "source_ids",
    "workspace_id"
  ],
  "title": "ResearchPack",
  "type": "object"
}
