{
  "$defs": {
    "EnergyShare": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kwh": {
          "minimum": 0,
          "title": "Kwh",
          "type": "number"
        }
      },
      "required": [
        "key",
        "kwh"
      ],
      "title": "EnergyShare",
      "type": "object"
    }
  },
  "$id": "https://content-factory.local/schema/EnergyReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnergyShare"
      },
      "title": "Attribution",
      "type": "array"
    },
    "cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "gaps": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Gaps",
      "type": "array"
    },
    "kwh_measured": {
      "minimum": 0,
      "title": "Kwh Measured",
      "type": "number"
    },
    "node_id": {
      "pattern": "^[a-z][a-z0-9]{1,7}_[A-Za-z0-9_-]{8,32}$",
      "title": "Node Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "enum": [
        "wall_meter",
        "nvml_gpu",
        "estimate"
      ],
      "title": "Source",
      "type": "string"
    },
    "tariff_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tariff Id"
    },
    "window_end": {
      "minLength": 4,
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "minLength": 4,
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "attribution",
    "cost",
    "currency",
    "gaps",
    "kwh_measured",
    "node_id",
    "schema_version",
    "source",
    "tariff_id",
    "window_end",
    "window_start"
  ],
  "title": "EnergyReport",
  "type": "object"
}
