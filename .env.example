# Copy to .env (git-ignored). Names only — never commit values.
# Compose ports (loopback only). Defaults avoid ports used by other local stacks.
CF_POSTGRES_PORT=5432
CF_TEMPORAL_PORT=7233
CF_TEMPORAL_UI_PORT=8233
CF_SEARXNG_PORT=8083
CF_S3_PORT=8333
CF_NTFY_PORT=8092
POSTGRES_PASSWORD=content_factory_dev

# Application (read by the control plane)
DATABASE_URL=postgresql+psycopg://content_factory:content_factory_dev@127.0.0.1:5432/content_factory
DATABASE_URL_TEST=postgresql+psycopg://content_factory:content_factory_dev@127.0.0.1:5432/content_factory_test
# VAULT_MASTER_KEY: 32 random bytes, base64 — generated by ./setup.sh (back it up!)
VAULT_MASTER_KEY=
# VAPID_KEYS: generated by ./setup.sh; JSON {"public":..., "private":...}
VAPID_KEYS=

# Bring-your-own provider credentials (all optional; absence enables offline fixtures)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
HF_API_TOKEN=
CIVITAI_API_TOKEN=

# Platform developer apps (operator-owned; configured per adapter in later phases)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_BASE_URL=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Model inventory: extra read-only roots for /v1/comfy/models (skill weights, model repos).
# JSON list; ~ expands. Example:
# CF__COMFYUI__EXTRA_MODEL_ROOTS='["/mnt/fast/models"]'

# Local AI stack (all git-ignored, ComfyUI-style): upstream checkouts in ./external, the weight
# store is /mnt/fast/models on this host, indexed by category in ./models, generated media in
# ./output. Only set these if the checkouts or the weights live somewhere else:
# AI_VIDEO_ROOT=/path/with/external-and-models
# AI_VIDEO_MODELS=/mnt/fast/models

# Music library for the select_music stage (manifest tracks.json validated as MusicTrack).
# CF__MEDIA_LIBRARY__MUSIC_DIR=fixtures/music

# Animation renderer: builtin (Pillow, zero deps) or manim (skills/video/manim, opt-in).
# CF__ANIMATION__EXECUTOR=builtin

# Control passes for the 3D scene-control layer: motion_plan (builtin 2D renderer) or blender
# (skills/video/blender_scene, needs the system Blender; character assets under assets_root).
# CF__CONTROLS__COMPILER=blender
# Hybrid workflow (route_shots): render | generate for beats outside generate_kinds;
# overrides are JSON keyed by beat id.
# CF__ROUTING__DEFAULT_ROUTE=render
# CF__ROUTING__OVERRIDES={"beat_000000002": "generate"}
# Live backends for run-local / workers (defaults are mocks). Stages start HiDream and
# ComfyUI themselves (local_services.auto_start) and hand the GPU over between them.
# CF__CONTROLS__COMPILER=blender
# CF__IMAGE_SEQUENCES__BACKEND=hidream
# CF__VIDEO__BACKEND=comfyui
# Narration voice. qwen3tts (skills/audio/qwen3tts, ~5 GB VRAM) is the local narration voice;
# it returns NO word timings, so the beats are force-aligned afterwards (aligner below).
# kokoro is the fallback: 82M params, CPU seconds per beat, and times its own tokens.
# CF__NARRATION__TTS=qwen3tts
# ryan | aiden | vivian | serena | uncle_fu | dylan | eric | ono_anna | sohee
# CF__NARRATION__QWEN_SPEAKER=ryan
# CF__NARRATION__QWEN_LANGUAGE=english
# CF__NARRATION__QWEN_INSTRUCT=Calm documentary narrator, unhurried.
# CF__NARRATION__QWEN_DEVICE=cuda:0
# Voice clone on the Base weights instead of a timbre (both required together):
# CF__NARRATION__QWEN_REF_AUDIO=takes/reference.wav
# CF__NARRATION__QWEN_REF_TEXT=Exactly what the reference clip says.
# How the words are timed: faster_whisper (measured) | even_split (offline estimate) | whisperx
# CF__NARRATION__ALIGNER=faster_whisper
# CF__NARRATION__TTS=kokoro
# CF__NARRATION__KOKORO_VOICE=af_heart
# Generated non-speech audio (sound_design's SFX bed, and generated music when it lands) goes
# through content_factory.audio.condition: the same detection, true-peak and length-lock stages as
# the voice chain, and NONE of its models — both were measured to destroy non-speech material.
# With conditioning on, the bed sits at bed_lufs and gain_db becomes a trim; with it off, the bed
# is at whatever level the model rendered and needs the large blind cut instead.
# CF__SOUND_DESIGN__CONDITION=false
# CF__SOUND_DESIGN__BED_LUFS=-23.0
# CF__SOUND_DESIGN__BED_TRIM_DB=0.0
# Speech restoration (restore_speech): the voice chain between the take and the mix.
# The FFmpeg tail (de-esser, EQ, light compression, resample to 48 kHz) is on by default;
# the two model steps need skills/audio/{clearervoice,resemble_enhance} built (`uv sync`) and
# the weights under models/speech_restoration/. See docs/setup.md "Speech restoration".
# CF__SPEECH_RESTORATION__ENHANCER=resemble_enhance
# CF__SPEECH_RESTORATION__CLEANUP=clearervoice
# CF__SPEECH_RESTORATION__BAND_EXTENSION=clearervoice_sr
# cpu is the default; cuda is ~19x faster for the enhancer but wants the card to itself.
# CF__SPEECH_RESTORATION__DEVICE=cuda
# detected: cleanup/band extension run only where the measurements ask. always: every beat.
# CF__SPEECH_RESTORATION__GATE=detected
# CF__SPEECH_RESTORATION__ENABLED=false
# CF__LOCAL_SERVICES__AUTO_START=true
# CF__CONTROLS__ASSETS_ROOT=/mnt/fast/models/blender-assets
# CF__SHOTS__PLANNER=story_presets
# Anchor / keyframe generator: mock (deterministic) or hidream (skills/image/hidream server).
# CF__IMAGE_SEQUENCES__BACKEND=hidream

# More than one GPU host. A sequence's frames are hub-and-spoke (each is an edit of the anchor,
# never of its neighbour) so they can be generated on different machines at the same time; at
# 100-385 s a frame that is most of a film's wall clock. Each list REPLACES the single endpoint
# above it, so the local server has to appear in the list to keep a share of the work. Unset (the
# default) is one endpoint and the serial path.
#
# The far host must be reachable: start its HiDream with CF_HIDREAM_HOST set to that machine's
# TAILNET address (never 0.0.0.0 -- the server has no auth), and its ComfyUI with --listen.
# CF__IMAGE_SEQUENCES__HIDREAM_ENDPOINTS=["http://127.0.0.1:8801","http://100.82.150.94:8801"]
# CF__IMAGE_SEQUENCES__FLUX2_ENDPOINTS=["http://127.0.0.1:8188","http://100.82.150.94:8188"]
# A pooled run must not also try to start and stop servers as if it owned them:
# CF__LOCAL_SERVICES__AUTO_START=false
# generate_video's clips are NOT pooled yet -- they run one at a time against CF__COMFYUI__ENDPOINT.

# Minimum password length (default 12; hard floor 4).
# CF__AUTH__PASSWORD_MIN_LENGTH=12
