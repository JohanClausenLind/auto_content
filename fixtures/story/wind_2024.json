   "beat_id": "beat_wind2024_01",
   "order": 0,
   "display_text": "In late 2024, Swedish wind out-produced nuclear for a whole quarter.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 4600
  },
  {
   "beat_id": "beat_wind2024_02",
   "order": 1,
   "display_text": "A record: 40.8 terawatt-hours of wind power in one year.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 3600
  },
  {
   "beat_id": "beat_wind2024_03",
   "order": 2,
   "display_text": "Its grid share doubled in six years: 10 percent to 21.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 4200
  },
  {
   "beat_id": "beat_wind2024_04",
   "order": 3,
   "display_text": "Then the orders collapsed, from twelve hundred megawatts to under four fifty.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 4600
  },
  {
   "beat_id": "beat_wind2024_05",
   "order": 4,
   "display_text": "Higher costs, slow grid connections and political uncertainty froze new investment.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 5200
  },
  {
   "beat_id": "beat_wind2024_06",
   "order": 5,
   "display_text": "Sweden used to add two gigawatts a year. Now it expects two by 2027, in total.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 5000
  },
  {
   "beat_id": "beat_wind2024_07",
   "order": 6,
   "display_text": "The record is real. The pipeline behind it is shrinking.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
   "words": [],
   "planned_duration_ms": 4000
  },
  {
   "beat_id": "beat_wind2024_08",
   "order": 7,
   "display_text": "Follow for the next number.",
   "spoken_text": null,
   "claim_ids": [],
   "measured_start_ms": null,
   "measured_end_ms": null,
