{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The root validates a full plan. For staged output, code builds the request's format from $defs/skeleton or $defs/beat_batch, and gives each batch a <state> computed from earlier batches (see prompt.md <output_size>).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title_question",
    "common_assumption",
    "answer",
    "takeaway",
    "audience",
    "target_duration_s",
    "layers",
    "explanation_spine",
    "color_semantics",
    "objects",
    "beats",
    "claims_to_verify",
    "notes"
  ],
  "properties": {
    "title_question": {
      "type": "string"
    },
    "common_assumption": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "target_duration_s": {
      "type": "integer",
      "minimum": 60,
      "maximum": 600
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "explanation_spine": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "claim"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "color_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "meaning"
        ],
        "properties": {
          "role": {
            "$ref": "#/$defs/color_role"
          },
          "meaning": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "claims_to_verify": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "ref_or_empty": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]*)?$"
    },
    "transition": {
      "type": "string",
      "enum": [
        "reveal",
        "highlight",
        "update",
        "morph",
        "split",
        "merge",
        "trace",
        "branch",
        "compare",
        "fault",
        "dismiss",
        "zoom_in",
        "zoom_out",
        "cut"
      ]
    },
    "color_role": {
      "type": "string",
      "enum": [
        "neutral",
        "software",
        "privileged",
        "hardware",
        "data",
        "fault",
        "accent_1",
        "accent_2"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "primitive",
        "label",
        "parent",
        "cell",
        "layer",
        "color_role",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "primitive": {
          "type": "string",
          "enum": [
            "box",
            "label",
            "arrow",
            "memory_row",
            "register",
            "code_block",
            "callout",
            "graph_line",
            "graph_bar",
            "data_packet",
            "chip",
            "process",
            "layer_boundary",
            "fault_marker",
            "timeline",
            "state_table"
          ]
        },
        "label": {
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/ref_or_empty"
        },
        "cell": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "layer": {
          "type": "string"
        },
        "color_role": {
          "$ref": "#/$defs/color_role"
        },
        "from": {
          "$ref": "#/$defs/ref_or_empty"
        },
        "to": {
          "$ref": "#/$defs/ref_or_empty"
        }
      }
    },
    "visual_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_sentence",
        "op",
        "targets",
        "into",
        "value",
        "note"
      ],
      "properties": {
        "at_sentence": {
          "type": "integer",
          "minimum": 0
        },
        "op": {
          "type": "string",
          "enum": [
            "reveal",
            "highlight",
            "update",
            "morph",
            "split",
            "merge",
            "trace",
            "branch",
            "compare",
            "fault",
            "dismiss"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "into": {
          "$ref": "#/$defs/ref_or_empty"
        },
        "value": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "beat",
        "sentence",
        "object"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "beat": {
          "type": "string",
          "pattern": "^b[0-9]{2}$"
        },
        "sentence": {
          "type": "integer",
          "minimum": -1
        },
        "object": {
          "$ref": "#/$defs/ref_or_empty"
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "goal",
        "question",
        "new_concept",
        "mechanism",
        "layer",
        "frame",
        "narration",
        "visual_updates",
        "transition_in",
        "transition_out",
        "est_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{2}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "question_hook",
            "common_assumption",
            "system_overview",
            "normal_flow",
            "edge_case",
            "exception_path",
            "layer_zoom",
            "comparison",
            "resolution",
            "takeaway"
          ]
        },
        "goal": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "new_concept": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "frame": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "narration": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "visual_updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual_update"
          }
        },
        "transition_in": {
          "$ref": "#/$defs/transition"
        },
        "transition_out": {
          "$ref": "#/$defs/transition"
        },
        "est_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "beat_outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "goal",
        "question",
        "new_concept",
        "mechanism",
        "layer",
        "frame",
        "transition_in",
        "transition_out",
        "est_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{2}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "question_hook",
            "common_assumption",
            "system_overview",
            "normal_flow",
            "edge_case",
            "exception_path",
            "layer_zoom",
            "comparison",
            "resolution",
            "takeaway"
          ]
        },
        "goal": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "new_concept": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "frame": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "transition_in": {
          "$ref": "#/$defs/transition"
        },
        "transition_out": {
          "$ref": "#/$defs/transition"
        },
        "est_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_question",
        "common_assumption",
        "answer",
        "takeaway",
        "audience",
        "target_duration_s",
        "layers",
        "explanation_spine",
        "color_semantics",
        "objects",
        "beats",
        "notes"
      ],
      "properties": {
        "title_question": {
          "type": "string"
        },
        "common_assumption": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "takeaway": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "target_duration_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 600
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "explanation_spine": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "claim"
            ],
            "properties": {
              "layer": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "color_semantics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "meaning"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/color_role"
              },
              "meaning": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat_outline"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "beat_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats",
        "claims_to_verify"
      ],
      "properties": {
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "claims_to_verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    }
  }
}
