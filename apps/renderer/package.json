{
  "name": "@content-factory/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Remotion-based video renderer (RenderBackend: local_process)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render:spike": "node ./scripts/render-spike.mjs",
    "render:artboard": "node ./scripts/render-artboard.mjs",
    "render:timeline": "node ./scripts/render-timeline.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@content-factory/content-schema-ts": "workspace:*",
    "@content-factory/content-ui": "workspace:*",
    "@content-factory/video-ui": "workspace:*",
    "@fontsource/inter": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@remotion/bundler": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/fonts": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.518",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "playwright": "1.63.0"
  }
}
